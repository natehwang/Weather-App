# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Required. Free READ key from https://develop.purpleair.com (Google login).
PURPLEAIR_API_KEY=your_read_key_here

# Optional — only needed if the Synoptic Data provider is added later.
# Free token from https://developers.synopticdata.com
SYNOPTIC_API_TOKEN=your_token_here

# NDBC and NWS (api.weather.gov) need no keys.
